DELIMITER //
CREATE PROCEDURE mysql.dropHostsForUser(IN u char(128), IN h char(225), OUT user_host char(255))
BEGIN
    DECLARE done int DEFAULT FALSE;
    DECLARE drop_host CHAR(255);
    DECLARE drop_hosts CURSOR FOR SELECT DISTINCT(CONCAT('`', user, '`@`', host, '`')) AS host FROM mysql.user WHERE user = u AND host NOT IN (h);

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    OPEN drop_hosts;
    DROPHOSTS: LOOP
        FETCH drop_hosts INTO drop_host;

        IF done = FALSE THEN
           SET @drop_stmt = (
               SELECT CONCAT('DROP USER IF EXISTS ', drop_host)
           );
           PREPARE STMT FROM @drop_stmt;
           EXECUTE STMT;
           ITERATE DROPHOSTS;
        END IF;
        LEAVE DROPHOSTS;
    END LOOP DROPHOSTS;
    CLOSE drop_hosts;
END //
DELIMITER ;

<% user_hosts = Hash.new -%>
<% # Ruby: parse hosts for each user -%>
<% @variables.each_value do |users| -%>
<%   users.each do |u, params| -%>
<%     user_hosts[u] || user_hosts[u] = Array.new -%>
<%     user_hosts[u].push(params[:host]) -%>
<%   end -%>
<% end -%>
<% user_hosts.each do |user, hosts| -%>
<%= "/* Cleaning up hosts not granted for user: #{user} */" %>
<% hosts = "'#{user_hosts[user].join("', '")}'" -%>
CALL mysql.dropHostsForUser('<%= user %>', "<%= hosts %>", @user_host);
<% end -%>

<% @variables.each do |db, users| -%>
<% dbname, table = db.to_s.include?('.') ? db.to_s.split('.') : [db.to_s, '*'] %>
<%= "/* ====== Managing DB: #{dbname} ====== */" %>
<% if dbname != '*' -%>
CREATE DATABASE IF NOT EXISTS `<%= dbname %>`;
<% end -%>

<% users.each do |user, params| -%>
<% if params[:action] == 'dropuser' -%>
<%= "/* Dropping user #{user} */" %>
DROP USER IF EXISTS `<%= user %>`@`<%= params[:host] %>`;

<% else -%>
<%= "/* Managing user: #{user} */" %>
CREATE USER IF NOT EXISTS `<%= user %>`@`<%= params[:host] %>`;

<%= "/* Comparing and updating password for #{user} */" %>
SET @update_passwd = (
    SELECT IF(password != PASSWORD('<%= DanarchyDeploy::Helpers.decode_base64(params[:password]) %>'),
    "ALTER USER `<%= user %>`@`<%= params[:host] %>`
           IDENTIFIED BY '<%= DanarchyDeploy::Helpers.decode_base64(params[:password]) %>'",
    "SELECT 1"
    ) AS update_passwd FROM mysql.user
    WHERE user = '<%= user %>'
    AND host = '<%= params[:host] %>'
);

PREPARE STMT FROM @update_passwd;
EXECUTE STMT;

<% if params[:user_limits] -%>
ALTER USER `<%= user %>`@`<%= params[:host] %>`
      WITH <%= params[:user_limits] %>;
<% end -%>

<% if params[:grant] -%>
<%= "/* Granting privileges on #{dbname} to #{user} */" %>
GRANT <%= params[:grant].join(', ') %>
      ON <%= dbname %>.<%= table %>
      TO `<%= user %>`@`<%= params[:host] %>`;
<% end -%>

<% if params[:revoke] -%>
<%= "/* Revoking privileges on #{dbname} to #{user} */" %>
REVOKE <%= params[:revoke].join(', ') %>
      ON <%= dbname %>.<%= table %>
      FROM `<%= user %>`@`<%= params[:host] %>`;
<% end -%>

<% end -%>
<% end -%>
<% end -%>

FLUSH PRIVILEGES;
DROP PROCEDURE IF EXISTS mysql.dropHostsForUser;
