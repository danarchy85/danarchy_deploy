# Deployed by dAnarchy_deploy: /etc/portage/make.conf
COMMON_FLAGS="-march=<%= `gcc -march=native -Q --help=target | grep march`.split[1] %> -O2 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"

MAKEOPTS="-j<%= @variables[:makeopts] ? @variables[:makeopts] : (`nproc`.to_f * 0.5).round %> -l<%= (`nproc`.to_f * 0.85) %>"
CPU_FLAGS_X86="<%= `cpuid2cpuflags`.split(': ').last.chomp %>"

<%
defaults = {
  :USE => "bindist logrotate bash-completion",
  :INPUT_DEVICES => "evdev keyboard"
}

defaults.merge(@variables[:options] || Hash.new).each do |k, v| -%>
<%= k.to_s.upcase + "=\"#{v}\"" %>
<% end -%>

# This sets the language of build output to English.
# Please keep this setting intact when reporting bugs.
LC_MESSAGES=C

PORTDIR="/var/db/repos/gentoo"
DISTDIR="/var/cache/distfiles"
PKGDIR="/var/cache/binpkgs"
